rl:
  act_coeff: 0.0             # NOT in paper Eq.4 — kept at 0 for faithfulness
  gate_bonus: 5.0            # NOT in paper Eq.4 — kept at 0
  survival_bonus: 0.0        # NOT in paper Eq.4 — kept at 0
  crash_penalty: 0.0          # NOT in paper Eq.4 — only r_T (gate collision) terminates with reward
  body_rate_coeff: 0.0005    # b·‖ω‖² penalty (paper Eq. 4)
  body_rate_anneal_steps: 5000000  # steps to anneal b → 0 (paper L140: "added at an initial training stage")
  gate_width: 5            # w_g — increased for easier learning (was 3)
  safety_coeff: 0.0          # a in paper Eq. 4 — disabled until base policy works
  safety_d_max: 1.5          # d_max for safety reward activation (meters)
  traj_init_threshold: 0.6   # mean gates/episode required to switch to Phase 2 (NOT a probability)
  traj_init_fraction: 0.5    # fraction of Phase 2 resets from traj buffer
  traj_init_min_episodes: 200  # per-env episode floor before Phase 2 is considered
  spline_deviation_ratio: 1.5  # progress penalty per meter of lateral deviation from spline
  deviation_penalty_coeff: 0.01  # per-step quadratic penalty for dev > gate_width/2
